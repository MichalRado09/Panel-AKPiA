# Szablon konfiguracji — skopiuj do pliku `.env` i uzupełnij własnymi wartościami.
# PLIK .env (bez rozszerzenia .example) NIGDY nie trafia do repozytorium
# (jest w .gitignore) — zawiera prawdziwe hasło i klucz API.

# Hasło dostępu do panelu (dowolny ciąg znaków, Ty je ustawiasz)
APP_PASSWORD=

# Klucz API Gemini z Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
